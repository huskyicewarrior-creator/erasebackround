# Copy to pi.env on the Pi. Do not commit pi.env.
# Add the exact deployed frontend origin(s), separated by commas. CORS is not authentication.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only enable this when the API can be reached solely through a correctly configured Cloudflare Tunnel.
TRUST_CLOUDFLARE_IP=false
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=12000000
MAX_QUEUE=3
RESULT_TTL_SECONDS=900
IP_HOURLY_LIMIT=20
DAILY_LIMIT=200
